{
  "id": "local-knowledge-query",
  "name": "Local Knowledge Query",
  "description": "Read-only private and household-shared NAS knowledge tools via the local policy broker.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "required": [
      "agents"
    ],
    "properties": {
      "agents": {
        "type": "object",
        "patternProperties": {
          "^.*$": {
            "type": "object",
            "required": [
              "private",
              "shared"
            ],
            "properties": {
              "private": {
                "type": "boolean"
              },
              "shared": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "knowledge_private",
      "knowledge_shared"
    ]
  }
}
