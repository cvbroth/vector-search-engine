{
  "id": "local-knowledge-query",
  "name": "Local Knowledge Query",
  "description": "Permanent knowledge query/import and separate temporary session-PDF retrieval tools.",
  "version": "0.2.6",
  "configSchema": {
    "type": "object",
    "required": [
      "agents"
    ],
    "properties": {
      "agents": {
        "type": "object",
        "patternProperties": {
          "^.*$": {
            "type": "object",
            "required": [
              "private",
              "shared"
            ],
            "properties": {
              "private": {
                "type": "boolean"
              },
              "shared": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "imports": {
        "type": "object",
        "patternProperties": {
          "^.*$": {
            "type": "object",
            "required": [
              "private",
              "shared"
            ],
            "properties": {
              "private": {
                "type": "boolean"
              },
              "shared": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "skills": [
    "./skills"
  ],
  "contracts": {
    "tools": [
      "knowledge_private",
      "knowledge_shared",
      "session_document_query",
      "knowledge_import_private",
      "knowledge_import_shared"
    ]
  }
}
